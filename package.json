{
  "name": "matharts-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "fonts:check": "nub scripts/check-font-glyphs.ts",
    "fonts:update": "nub scripts/update-local-fonts.ts",
    "check": "astro check",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "lighthouse:check": "node scripts/run-lighthouse.mjs --check",
    "test:e2e": "playwright test",
    "verify": "pnpm fonts:check && pnpm check && pnpm lint && pnpm format:check && pnpm test:e2e",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.13.0",
    "@jdevalk/astro-seo-graph": "2.2.0",
    "@playwright/test": "1.62.1",
    "lighthouse": "13.4.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "wrangler": "4.121.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0"
    }
  }
}
