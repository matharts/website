{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "labels": ["dependencies"],
  "assignees": ["lzm0x219"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "Mirror pnpm minimumReleaseAgeExclude: these packages bypass the 1-day supply-chain age policy",
      "matchPackageNames": [
        "astro",
        "@astrojs/markdown-satteri",
        "wrangler",
        "miniflare",
        "workerd",
        "@cloudflare/workerd",
        "@cloudflare/workerd-**"
      ],
      "minimumReleaseAge": null
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["ox**"]
    },
    {
      "description": "astro check still needs TypeScript 6.x programmatic API",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "autoApprove": true,
  "automerge": false,
  "automergeStrategy": "squash",
  "ignoreTests": false
}
